#!/bin/sh

choice=$(printf '%s\n' 'Lock' 'Logout' 'Suspend' 'Reboot' 'Shutdown' | \
    rofi -dmenu -i -p 'Power' -theme-str 'window { width: 22%; } listview { lines: 5; }')

case "$choice" in
    Lock)
        i3lock -c 000000
        ;;
    Logout)
        i3-msg exit
        ;;
    Suspend)
        systemctl suspend
        ;;
    Reboot)
        systemctl reboot
        ;;
    Shutdown)
        systemctl poweroff
        ;;
esac
