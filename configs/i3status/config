
# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	output_format = "i3bar"
        colors = true
        interval = 1
        markup = "pango"            # Enables individual color wrapping
        
        # Fallback Dracula Colors
        # color_good = "#50FA7B"      # Green
        # color_degraded = "#F1FA8C"  # Yellow
        # color_bad = "#FF5555"       # Red
}

order += "cpu_usage"
order += "memory"
# order += "wireless _first_"
order += "volume master"
order += "battery all"
order += "tztime date"
order += "tztime weekday"
order += "tztime time"

wireless _first_ {
        format_up = "📶%essid"
        format_down = "📶 down"
}

ethernet _first_ {
        format_up = "(%speed)"
        format_down = "E: down"
}

battery all {
        format = "bat %percentage"
        integer_battery_capacity = true
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        # Cyan
	format = "ram %percentage_used"
	#format = "📏%percentage_used"
	decimals = 0
        #format = "%used/%total"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

cpu_usage {
        # Foreground color
        format = "cpu %usage"
        # format = "🔲%usage"
}

volume master {
        # Orange color
        #format = "🔊%volume"
        format = "vol %volume"
        format_muted = "MUTED"
}

tztime date {
        format = "<span text_transform=\"lowercase\" color=\"#FFFF00\">%d %b</span>"
}

tztime weekday {
	format = "<span text_transform=\"lowercase\">%A</span>"
}

tztime time {
        # Current Line color
        format = "<span color=\"#FFFF00\">%H:%M</span>"
}
