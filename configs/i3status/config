
# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	output_format = "i3bar"
        colors = true
        interval = 1
        separator = ""
        markup = "pango"            # Enables individual color wrapping

        # Fallback Dracula Colors
        color_good = "#50FA7B"      # Green
        color_degraded = "#F1FA8C"  # Yellow
        color_bad = "#FF5555"       # Red
}

order += "memory"
order += "cpu_usage"
order += "volume master"
order += "tztime time"
order += "tztime date"

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "(%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "<span line_height='2' background='#711c91' color='#ffffff'> ram %percentage_used </span>"
        #format = "RAM %percentage_used"
        #format_degraded = "MEMORY < %available"
        separator_block_width = 0
}

cpu_usage {
        # Foreground color
        format = "<span line_height='2' background='#0abdc6' color='#000000'> cpu %usage </span>"
        #format = "CPU %usage"
        separator_block_width = 0
}

volume master {
        #format = "VOL %volume"
        format = "<span line_height='2' background='#133e7c' color='#ffffff'> vol %volume </span>"
        format_muted = "<span line_height='2' background='#133e7c' color='#ffffff'> muted </span>"
        #format_muted = "🔇%volume"
        separator_block_width = 0
        # format_muted = "<span color='#FF5555'>🔇%volume</span>"
}

tztime time {
        format = "<span background='#ea00d9'><span font_size='90%' rise='9000' color='#ea00d9'>x</span><span color='#000000'>%H:%M</span><span font_size='90%' rise='-6000' color='#ea00d9'>x</span></span>"
        separator_block_width = 0
}

tztime date {
        #format = "%Y.%m.%d"
        format = "<span line_height='2' background='#091833' color='#ffffff'> %d %b <span color='#ea00d9'>[%A]</span> </span>"
        separator_block_width = 0
}
