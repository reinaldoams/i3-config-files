
# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	output_format = "i3bar"
        colors = true
        interval = 1
        markup = "pango"            # Enables individual color wrapping
        
        # Fallback Dracula Colors
        # color_good = "#50FA7B"      # Green
        # color_degraded = "#F1FA8C"  # Yellow
        # color_bad = "#FF5555"       # Red
}

order += "cpu_usage"
order += "memory"
order += "wireless _first_"
order += "volume master"
order += "tztime date"
order += "tztime weekday"
order += "tztime time"

wireless _first_ {
        format_up = "📶%essid"
        format_down = "📶 down"
}

ethernet _first_ {
        format_up = "(%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        # Cyan
	format = "📏%percentage_used"
        #format = "%used/%total"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

cpu_usage {
        # Foreground color
        format = "🔲%usage"
}

volume master {
        # Orange color
        format = "🔊%volume"
        format_muted = "🔇%volume"
}

tztime date {
        format = "%d %b"
}

tztime weekday {
	format = "%a"
}

tztime time {
        # Current Line color
        format = "%H:%M"
}
