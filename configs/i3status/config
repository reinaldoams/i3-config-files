
# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	output_format = "i3bar"
        colors = true
        interval = 1
        separator = ""
        markup = "pango"            # Enables individual color wrapping

        # Fallback colors (99x logo palette)
        color_good = "#A2B372"
        color_degraded = "#CCB189"
        color_bad = "#B44B4B"
}

order += "cpu_usage"
order += "memory"
# order += "wireless _first_"
order += "volume master"
order += "battery all"
order += "tztime date"
order += "tztime weekday"
order += "tztime time"

wireless _first_ {
        format_up = "📶%essid"
        format_down = "📶 down"
}

ethernet _first_ {
        format_up = "(%speed)"
        format_down = "E: down"
}

battery all {
        format = "<span line_height='2' text_transform='lowercase' background='#7A6977' color='#ffffff'> bat %percentage </span>"
        integer_battery_capacity = true
        separator_block_width = 0
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "<span line_height='2' text_transform='lowercase' background='#905B54' color='#ffffff'> ram %percentage_used </span>"
        decimals = 0
        threshold_degraded = "1G"
        format_degraded = "<span line_height='2' text_transform='lowercase' background='#B44B4B' color='#ffffff'> ram &lt; %available </span>"
        separator_block_width = 0
}

cpu_usage {
        format = "<span line_height='2' text_transform='lowercase' background='#A2B372' color='#1c1c1c'> cpu %usage </span>"
        separator_block_width = 0
}

volume master {
        format = "<span line_height='2' text_transform='lowercase' background='#BC8E58' color='#1c1c1c'> vol %volume </span>"
        format_muted = "<span line_height='2' text_transform='lowercase' background='#B44B4B' color='#ffffff'> muted </span>"
        separator_block_width = 0
}

tztime date {
        format = "<span line_height='2' text_transform='lowercase' background='#CCB189' color='#1c1c1c'> %d %b </span>"
        separator_block_width = 0
}

tztime weekday {
        format = "<span line_height='2' text_transform='lowercase' background='#1c1c1c' color='#CCB189'> [%A]</span>"
        separator_block_width = 0
}

tztime time {
        format = "<span background='#1c1c1c'><span font_size='90%' rise='9000' color='#1c1c1c'>x</span><span color='#ffffff'>%H:%M</span><span font_size='90%' rise='-6000' color='#1c1c1c'>x</span></span>"
        separator_block_width = 0
}
