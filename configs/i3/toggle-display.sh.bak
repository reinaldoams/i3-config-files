#!/bin/bash
STATE_FILE="$HOME/.cache/i3-display-mode"
HDMI="HDMI-A-0"
DP="DisplayPort-0"

mkdir -p "$(dirname "$STATE_FILE")"
mode=$(cat "$STATE_FILE" 2>/dev/null || echo "hdmi")

if [ "$mode" = "hdmi" ]; then
  xrandr --output "$DP" --primary --mode 2560x1440 --rate 179.85 --rotate normal --pos 0x0 --output "$HDMI" --off
  notify-send -t 1500 "Display" "DisplayPort only"
  echo "dp" > "$STATE_FILE"
  gammastep -P -O 3000
else
  xrandr --output "$HDMI" --primary --mode 2560x1440 --rate 144.00 --rotate left --pos 0x0 --output "$DP" --off
  notify-send -t 1500 "Display" "HDMI only"
  echo "hdmi" > "$STATE_FILE"
  gammastep -P -O 3000
fi

pkill xwinwrap 2>/dev/null
pkill -f 'mpv.*wallpaper-video\.mp4' 2>/dev/null
feh --bg-fill "$HOME/Pictures/wallpaper-i3.png"
