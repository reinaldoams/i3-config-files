#!/bin/bash
xrandr --output DisplayPort-0 --primary --mode 2560x1440 --rate 179.85 --rotate normal --pos 0x0 \
  --output HDMI-A-0 --mode 2560x1440 --rate 144.00 --rotate left --pos 2560x0

pkill xwinwrap 2>/dev/null
pkill -f 'mpv.*wallpaper-video\.mp4' 2>/dev/null
feh --bg-fill "$HOME/Pictures/wallpaper-i3.png"
