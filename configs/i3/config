set $mod Mod4

font pango:FiraCode Nerd Font 15

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex-autostart --autostart --environment i3

# Make systemd graphical-session (and xdg-desktop-portal) available under i3
# so Flatpak apps can open links in the browser
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP
exec --no-startup-id systemctl --user start i3-session.target
exec --no-startup-id nm-applet

# gammastep (night mode)
exec --no-startup-id gammastep -P -O 3000

# setting wallpaper
exec --no-startup-id feh --bg-fill ~/Pictures/wallpaper-i3.png

# setting video wallpaper
# exec_always --no-startup-id bash -c "pgrep -x xwinwrap >/dev/null || $HOME/.config/i3/video-wallpaper.sh"

# setting picom compositor
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf -b

# setting polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# setting parcellite clipboard manager
exec --no-startup-id parcellite

# use DisplayPort-0 display
exec --no-startup-id xrandr --output DisplayPort-0 --primary --mode 2560x1440 --rate 180 --output HDMI-A-0 --off

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && \
    notify-send -t 1000 -h int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1) "Volume" ""
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && \
    notify-send -t 1000 -h int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1) "Volume" ""
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && \
    notify-send -t 1000 "Volume" "Toggled mute"

# open waterfox with Win + w
#bindsym $mod+w exec --no-startup-id flatpak run net.waterfox.waterfox
bindsym $mod+w exec --no-startup-id flatpak run app.zen_browser.zen
# open firefox with Win + b
bindsym $mod+b exec --no-startup-id firefox

# open thunar file manager
bindsym $mod+e exec --no-startup-id thunar

# screen lock shortcut
bindsym $mod+l exec --no-startup-id env \
    XSECURELOCK_SAVER=saver_mpv \
    XSECURELOCK_LIST_VIDEOS_COMMAND="printf '%s\n' /home/reinaldo/Videos/lock-screen-video.mp4" \
    XSECURELOCK_VIDEOS_FLAGS="--no-osc --no-osd-bar" \
    xsecurelock

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal

# kill focused window
bindsym $mod+q kill

# start rofi
bindsym $mod+d exec --no-startup-id rofi -show drun

# change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# toggle split orientation
bindsym $mod+semicolon split toggle

# enter fullscreen mode for the focused container
# bindsym $mod+f fullscreen toggle (inactive because Super+f now toggles floating mode)

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout toggle all

# toggle tiling / floating
bindsym $mod+f floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# use both displays
bindsym $mod+Shift+p exec --no-startup-id $HOME/.config/i3/dual-display.sh

# toggle between displays
bindsym $mod+p exec ~/.config/i3/toggle-display.sh

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Resizing windows
bindsym $mod+Control Right resize grow   width  5 px or 5 ppt
bindsym $mod+Control Left  resize shrink width  5 px or 5 ppt
bindsym $mod+Control Up    resize grow   height 5 px or 5 ppt
bindsym $mod+Control Down  resize shrink height 5 px or 5 ppt

bindsym Print exec --no-startup-id flameshot gui

# class                 border    bground   text      indicator child_border
client.focused          #6272A4   #6272A4   #F8F8F2   #FFFF00   #777777
client.focused_inactive #44475A   #44475A   #F8F8F2   #6272A4   #44475A
client.unfocused        #282A36   #282A36   #BFBFBF   #282A36   #282A36
client.urgent           #44475A   #FF5555   #F8F8F2   #FF5555   #FF5555
client.placeholder      #282A36   #282A36   #F8F8F2   #282A36   #282A36
client.background                 #F8F8F2

# styling windows borders
for_window [class="^.*"] border pixel 3
# adding a little margin around windows
gaps inner 5

# Making pop-up windows of some programs floating enable
for_window [class="Steam"] floating enable
for_window [class="steamwebhelper"] floating enable
for_window [class="qBittorrent" title="^Add New Torrent$"] floating enable
for_window [class="^Wine$"] floating enable
for_window [class="^Reaper$"] floating enable
for_window [class="wine"] floating enable
for_window [class="Wine"] floating enable

# Disable X DPMS / screensaver idle blanking (xset package not required)
exec --no-startup-id $HOME/.local/bin/disable-dpms
